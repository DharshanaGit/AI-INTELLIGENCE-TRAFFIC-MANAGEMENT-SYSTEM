# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/traffic_db?retryWrites=true&w=majority
DATABASE_NAME=traffic_db

# Alert Gateway (SMTP / Carrier SMS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
ALERT_RECIPIENT_SMS_GATEWAY=1234567890@tmomail.net
ALERT_RECIPIENT_EMAIL=traffic_control@domain.com

# Server Config
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
